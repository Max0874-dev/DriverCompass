<Project>

  <!--
    ============================================================
    Central product identity: CHANGE THE DISPLAY NAME HERE ONLY.
    It is used for the window title, reports, assembly metadata
    and the MSIX manifest. Project names and namespaces stay
    "DriverCompass.*" on purpose.
    ============================================================
  -->
  <PropertyGroup>
    <DriverCompassDisplayName>DriverCompass</DriverCompassDisplayName>
    <!-- Replace OWNER with the GitHub account once the repository exists. -->
    <DriverCompassRepositoryUrl>https://github.com/OWNER/DriverCompass</DriverCompassRepositoryUrl>
    <DriverCompassCatalogUrl>https://raw.githubusercontent.com/OWNER/DriverCompass/main/data/vendors.json</DriverCompassCatalogUrl>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <Product>$(DriverCompassDisplayName)</Product>
    <Company>DriverCompass contributors</Company>
    <Authors>DriverCompass contributors</Authors>
    <Copyright>Copyright (c) 2026 DriverCompass contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>$(DriverCompassRepositoryUrl)</RepositoryUrl>
    <NeutralLanguage>en-US</NeutralLanguage>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <SatelliteResourceLanguages>en;de</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="DriverCompass.DisplayName" Value="$(DriverCompassDisplayName)" />
    <AssemblyMetadata Include="DriverCompass.RepositoryUrl" Value="$(DriverCompassRepositoryUrl)" />
    <AssemblyMetadata Include="DriverCompass.CatalogUrl" Value="$(DriverCompassCatalogUrl)" />
  </ItemGroup>

</Project>
