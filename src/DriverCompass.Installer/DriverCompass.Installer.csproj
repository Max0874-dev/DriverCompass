<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Stage 3 installer engine. Runs ONLY inside a separate, elevated process
    (DriverCompass.exe with the elevated switch, started via UAC). The normal app never runs elevated.
    It is a library rather than its own EXE so the self-contained app does not ship a second .NET runtime.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DriverCompass.Installer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DriverCompass.Core\DriverCompass.Core.csproj" />
    <ProjectReference Include="..\DriverCompass.Scanner.Windows\DriverCompass.Scanner.Windows.csproj" />
    <ProjectReference Include="..\DriverCompass.VersionProviders\DriverCompass.VersionProviders.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DriverCompass.Installer.Tests" />
  </ItemGroup>

</Project>
