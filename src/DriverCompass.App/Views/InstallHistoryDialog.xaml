<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="DriverCompass.App.Views.InstallHistoryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:DriverCompass.App.Services"
    xmlns:vm="using:DriverCompass.App.ViewModels"
    Style="{StaticResource DefaultContentDialogStyle}"
    DefaultButton="Close">

  <Grid Width="480" MaxHeight="520">
    <TextBlock x:Name="EmptyText" Text="{x:Bind svc:Localizer.T('History_Empty')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    <ListView x:Name="HistoryList" SelectionMode="Single" SelectionChanged="OnSelectionChanged">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="vm:InstallHistoryItem">
          <StackPanel Padding="0,8" Spacing="2">
            <TextBlock Text="{x:Bind Heading}" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind DeviceName}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind Details}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                       Visibility="{x:Bind svc:StatusVisuals.VisibleIfText(Details)}" />
            <TextBlock Text="{x:Bind WhenText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</ContentDialog>
