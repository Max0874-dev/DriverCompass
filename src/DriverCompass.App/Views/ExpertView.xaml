<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DriverCompass.App.Views.ExpertView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:DriverCompass.App.Services"
    xmlns:vm="using:DriverCompass.App.ViewModels">

  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,380" Padding="16,4,16,0" ColumnSpacing="12">

    <!-- Search / filters -->
    <Grid Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,8">
      <TextBox MinWidth="240" PlaceholderText="{x:Bind svc:Localizer.T('Expert_Search')}"
               Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <ComboBox Grid.Column="1" MinWidth="170"
                ItemsSource="{x:Bind ViewModel.StatusFilterOptions}"
                SelectedIndex="{x:Bind ViewModel.StatusFilterIndex, Mode=TwoWay}" />
      <ComboBox Grid.Column="2" MinWidth="190"
                ItemsSource="{x:Bind ViewModel.ClassOptions}"
                SelectedIndex="{x:Bind ViewModel.SelectedClassIndex, Mode=TwoWay}" />
      <ToggleSwitch Grid.Column="3" MinWidth="0" OnContent="{x:Bind svc:Localizer.T('Expert_ShowSystem')}" OffContent="{x:Bind svc:Localizer.T('Expert_ShowSystem')}"
                    IsOn="{x:Bind ViewModel.ShowSystemDevices, Mode=TwoWay}" />
    </Grid>

    <TextBlock Grid.Row="2" Margin="4,6,0,8" Text="{x:Bind ViewModel.ExpertCountText, Mode=OneWay}"
               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

    <!-- ===== Table (scrolls horizontally on narrow windows) ===== -->
    <ScrollViewer Grid.Row="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
    <Grid RowDefinitions="Auto,*" HorizontalAlignment="Left">

      <!-- Sortable column headers (same widths as the rows below) -->
      <Grid Grid.Row="0" Padding="12,0" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4,4,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="160" />
          <ColumnDefinition Width="270" />
          <ColumnDefinition Width="160" />
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="170" />
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="95" />
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="230" />
          <ColumnDefinition Width="100" />
          <ColumnDefinition Width="56" />
          <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Style="{StaticResource ColumnHeaderButtonStyle}" Content="{x:Bind svc:Localizer.T('Col_Status')}" Command="{x:Bind ViewModel.SortCommand}" CommandParameter="Status" />
        <Button Grid.Column="1" Style="{StaticResource ColumnHeaderButtonStyle}" Content="{x:Bind svc:Localizer.T('Col_Name')}" Command="{x:Bind ViewModel.SortCommand}" CommandParameter="Name" />
        <Button Grid.Column="2" Style="{StaticResource ColumnHeaderButtonStyle}" Content="{x:Bind svc:Localizer.T('Col_Category')}" Command="{x:Bind ViewModel.SortCommand}" CommandParameter="Category" />
        <Button Grid.Column="3" Style="{StaticResource ColumnHeaderButtonStyle}" Content="{x:Bind svc:Localizer.T('Col_Vendor')}" Command="{x:Bind ViewModel.SortCommand}" CommandParameter="Vendor" />
        <Button Grid.Column="4" Style="{StaticResource ColumnHeaderButtonStyle}" Content="{x:Bind svc:Localizer.T('Col_Provider')}" Command="{x:Bind ViewModel.SortCommand}" CommandParameter="Provider" />
        <Button Grid.Column="5" Style="{StaticResource ColumnHeaderButtonStyle}" Content="{x:Bind svc:Localizer.T('Col_Version')}" Command="{x:Bind ViewModel.SortCommand}" CommandParameter="Version" />
        <Button Grid.Column="6" Style="{StaticResource ColumnHeaderButtonStyle}" Content="{x:Bind svc:Localizer.T('Col_Date')}" Command="{x:Bind ViewModel.SortCommand}" CommandParameter="Date" />
        <Button Grid.Column="7" Style="{StaticResource ColumnHeaderButtonStyle}" Content="{x:Bind svc:Localizer.T('Col_Latest')}" Command="{x:Bind ViewModel.SortCommand}" CommandParameter="Latest" />
        <Button Grid.Column="8" Style="{StaticResource ColumnHeaderButtonStyle}" Content="{x:Bind svc:Localizer.T('Col_VersionState')}" Command="{x:Bind ViewModel.SortCommand}" CommandParameter="VersionState" />
        <Button Grid.Column="9" Style="{StaticResource ColumnHeaderButtonStyle}" Content="{x:Bind svc:Localizer.T('Col_Inf')}" Command="{x:Bind ViewModel.SortCommand}" CommandParameter="Inf" />
        <Button Grid.Column="10" Style="{StaticResource ColumnHeaderButtonStyle}" Content="{x:Bind svc:Localizer.T('Col_ErrorCode')}" Command="{x:Bind ViewModel.SortCommand}" CommandParameter="Code" />
        <Button Grid.Column="11" Style="{StaticResource ColumnHeaderButtonStyle}" Content="{x:Bind svc:Localizer.T('Col_HardwareId')}" Command="{x:Bind ViewModel.SortCommand}" CommandParameter="HardwareId" />
      </Grid>

      <ListView x:Name="DeviceList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.ExpertItems}" SelectionMode="Single"
                SelectionChanged="OnSelectionChanged" BorderThickness="1,0,1,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="36" />
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="vm:DeviceItemViewModel">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="95" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="380" />
              </Grid.ColumnDefinitions>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="6,0" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind StatusText}">
                <FontIcon Glyph="{x:Bind StatusGlyph}" Foreground="{x:Bind StatusBrush}" FontSize="14" />
                <TextBlock Grid.Column="1" Text="{x:Bind StatusText}" TextTrimming="CharacterEllipsis" />
              </Grid>
              <TextBlock Grid.Column="1" Style="{StaticResource CellTextStyle}" Text="{x:Bind Name}" ToolTipService.ToolTip="{x:Bind Name}" />
              <TextBlock Grid.Column="2" Style="{StaticResource CellTextStyle}" Text="{x:Bind Category}" ToolTipService.ToolTip="{x:Bind DeviceClass}" />
              <TextBlock Grid.Column="3" Style="{StaticResource CellTextStyle}" Text="{x:Bind Vendor}" />
              <TextBlock Grid.Column="4" Style="{StaticResource CellTextStyle}" Text="{x:Bind Provider}" />
              <TextBlock Grid.Column="5" Style="{StaticResource CellTextStyle}" Text="{x:Bind Version}" />
              <TextBlock Grid.Column="6" Style="{StaticResource CellTextStyle}" Text="{x:Bind DateText}" />
              <TextBlock Grid.Column="7" Style="{StaticResource CellTextStyle}" Text="{x:Bind LatestVersionText}" ToolTipService.ToolTip="{x:Bind VersionPackageText}" />
              <Grid Grid.Column="8" ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="6,0" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind VersionStatusText}">
                <FontIcon Glyph="{x:Bind VersionGlyph}" Foreground="{x:Bind VersionBrush}" FontSize="12" Visibility="{x:Bind svc:StatusVisuals.VisibleIf(HasVersionCheck)}" />
                <TextBlock Grid.Column="1" Text="{x:Bind VersionStatusText}" Foreground="{x:Bind VersionBrush}" TextTrimming="CharacterEllipsis" />
              </Grid>
              <TextBlock Grid.Column="9" Style="{StaticResource CellTextStyle}" Text="{x:Bind Inf}" />
              <TextBlock Grid.Column="10" Style="{StaticResource CellTextStyle}" Text="{x:Bind ErrorCodeText}" />
              <TextBlock Grid.Column="11" Style="{StaticResource CellTextStyle}" Text="{x:Bind HardwareId}" FontFamily="Consolas" ToolTipService.ToolTip="{x:Bind HardwareId}" />
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Grid>
    </ScrollViewer>

    <!-- ===== Details ===== -->
    <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" CornerRadius="8" BorderThickness="1" Margin="0,0,0,12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
      <Grid>
        <TextBlock Text="{x:Bind svc:Localizer.T('Detail_None')}" Margin="16" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Visibility="{x:Bind svc:StatusVisuals.VisibleIfNot(HasSelection), Mode=OneWay}" />

        <ScrollViewer Visibility="{x:Bind svc:StatusVisuals.VisibleIf(HasSelection), Mode=OneWay}">
          <StackPanel Padding="16" Spacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="{x:Bind ViewModel.SelectedItem.Name, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="{x:Bind ViewModel.SelectedItem.StatusGlyph, Mode=OneWay}" Foreground="{x:Bind ViewModel.SelectedItem.StatusBrush, Mode=OneWay}" FontSize="14" />
                <TextBlock Text="{x:Bind ViewModel.SelectedItem.StatusText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
              </StackPanel>
              <TextBlock Text="{x:Bind ViewModel.SelectedItem.Reason, Mode=OneWay}" TextWrapping="Wrap" />
              <TextBlock Text="{x:Bind ViewModel.SelectedItem.Note, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Driver sources -->
            <StackPanel Spacing="2">
              <TextBlock Text="{x:Bind svc:Localizer.T('Col_Links')}" Style="{StaticResource BodyStrongTextBlockStyle}" />
              <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedItem.Links, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LinkViewModel">
                    <HyperlinkButton Command="{x:Bind OpenCommand}" Padding="0,4" ToolTipService.ToolTip="{x:Bind Uri}">
                      <StackPanel>
                        <TextBlock Text="{x:Bind Label}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Host}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                      </StackPanel>
                    </HyperlinkButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Stage 2: version check result -->
            <StackPanel Spacing="2" Visibility="{x:Bind svc:StatusVisuals.VisibleIf(ViewModel.SelectedItem.HasVersionCheck), Mode=OneWay}">
              <TextBlock Text="{x:Bind svc:Localizer.T('Col_VersionState')}" Style="{StaticResource BodyStrongTextBlockStyle}" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="{x:Bind ViewModel.SelectedItem.VersionGlyph, Mode=OneWay}" Foreground="{x:Bind ViewModel.SelectedItem.VersionBrush, Mode=OneWay}" FontSize="12" />
                <TextBlock Text="{x:Bind ViewModel.SelectedItem.VersionStatusText, Mode=OneWay}" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock Text="{x:Bind ViewModel.SelectedItem.LatestVersionText, Mode=OneWay}" IsTextSelectionEnabled="True" />
              <TextBlock Text="{x:Bind ViewModel.SelectedItem.VersionPackageText, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <Button Style="{StaticResource AccentButtonStyle}" Margin="0,4,0,0" Content="{x:Bind svc:Localizer.T('Simple_Install')}"
                      Command="{x:Bind ViewModel.SelectedItem.InstallCommand, Mode=OneWay}"
                      Visibility="{x:Bind svc:StatusVisuals.VisibleIf(ViewModel.SelectedItem.CanInstall), Mode=OneWay}" />
              <HyperlinkButton Content="{x:Bind ViewModel.SelectedItem.VersionActionText, Mode=OneWay}" Padding="0,4"
                               Command="{x:Bind ViewModel.SelectedItem.OpenVersionSourceCommand, Mode=OneWay}"
                               Visibility="{x:Bind svc:StatusVisuals.VisibleIf(ViewModel.SelectedItem.ShowVersionAction), Mode=OneWay}" />
            </StackPanel>

            <!-- Step-by-step help to get and install the driver -->
            <Button Content="{x:Bind svc:Localizer.T('Guide_Button')}"
                    Command="{x:Bind ViewModel.SelectedItem.ShowGuideCommand, Mode=OneWay}"
                    Visibility="{x:Bind svc:StatusVisuals.VisibleIf(ViewModel.SelectedItem.ShowGuide), Mode=OneWay}" />

            <!-- Key facts -->
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4">
              <TextBlock Grid.Row="0" Text="{x:Bind svc:Localizer.T('Col_DeviceClass')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.SelectedItem.DeviceClass, Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
              <TextBlock Grid.Row="1" Text="{x:Bind svc:Localizer.T('Col_Vendor')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SelectedItem.Vendor, Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
              <TextBlock Grid.Row="2" Text="{x:Bind svc:Localizer.T('Col_Manufacturer')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.SelectedItem.Manufacturer, Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
              <TextBlock Grid.Row="3" Text="{x:Bind svc:Localizer.T('Col_Provider')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.SelectedItem.Provider, Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
              <TextBlock Grid.Row="4" Text="{x:Bind svc:Localizer.T('Col_Version')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.SelectedItem.Version, Mode=OneWay}" IsTextSelectionEnabled="True" />
              <TextBlock Grid.Row="5" Text="{x:Bind svc:Localizer.T('Col_Date')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.SelectedItem.DateText, Mode=OneWay}" />
              <TextBlock Grid.Row="6" Text="{x:Bind svc:Localizer.T('Col_Inf')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Bind ViewModel.SelectedItem.Inf, Mode=OneWay}" IsTextSelectionEnabled="True" />
              <TextBlock Grid.Row="7" Text="{x:Bind svc:Localizer.T('Col_Signer')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <TextBlock Grid.Row="7" Grid.Column="1" Text="{x:Bind ViewModel.SelectedItem.Signer, Mode=OneWay}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="8" Text="{x:Bind svc:Localizer.T('Col_ErrorCode')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <TextBlock Grid.Row="8" Grid.Column="1" Text="{x:Bind ViewModel.SelectedItem.ErrorCodeText, Mode=OneWay}" />
            </Grid>

            <!-- Instance path -->
            <StackPanel Spacing="2">
              <TextBlock Text="{x:Bind svc:Localizer.T('Col_InstanceId')}" Style="{StaticResource BodyStrongTextBlockStyle}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                <TextBlock Text="{x:Bind ViewModel.SelectedItem.InstanceId, Mode=OneWay}" FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True" VerticalAlignment="Center" />
                <Button Grid.Column="1" Command="{x:Bind ViewModel.SelectedItem.CopyInstanceIdCommand, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind svc:Localizer.T('Detail_Copy')}">
                  <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                </Button>
              </Grid>
            </StackPanel>

            <!-- Hardware IDs -->
            <StackPanel Spacing="2">
              <TextBlock Text="{x:Bind svc:Localizer.T('Col_HardwareIds')}" Style="{StaticResource BodyStrongTextBlockStyle}" />
              <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedItem.HardwareIds, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HardwareIdItem">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" Margin="0,2">
                      <TextBlock Text="{x:Bind Id}" FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Command="{x:Bind CopyCommand}" ToolTipService.ToolTip="{x:Bind svc:Localizer.T('Detail_Copy')}">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                      </Button>
                      <Button Grid.Column="2" Command="{x:Bind SearchCatalogCommand}" ToolTipService.ToolTip="{x:Bind svc:Localizer.T('Detail_SearchCatalog')}">
                        <FontIcon Glyph="&#xE721;" FontSize="14" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Compatible IDs -->
            <StackPanel Spacing="2">
              <TextBlock Text="{x:Bind svc:Localizer.T('Col_CompatibleIds')}" Style="{StaticResource BodyStrongTextBlockStyle}" />
              <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedItem.CompatibleIds, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HardwareIdItem">
                    <TextBlock Text="{x:Bind Id}" FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True" Margin="0,2" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
