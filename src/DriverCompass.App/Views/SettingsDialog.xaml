<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="DriverCompass.App.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:DriverCompass.App.Services"
    Style="{StaticResource DefaultContentDialogStyle}"
    DefaultButton="Primary">

  <ScrollViewer MaxHeight="560">
    <StackPanel Spacing="14" MinWidth="460" Padding="0,0,12,0">

      <StackPanel Spacing="4">
        <ComboBox Header="{x:Bind svc:Localizer.T('Settings_Language')}" MinWidth="220"
                  ItemsSource="{x:Bind ViewModel.LanguageOptions}"
                  SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}" />
        <TextBlock Text="{x:Bind svc:Localizer.T('Settings_LanguageRestart')}" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
      </StackPanel>

      <ComboBox Header="{x:Bind svc:Localizer.T('Settings_StartView')}" MinWidth="220"
                ItemsSource="{x:Bind ViewModel.StartViewOptions}"
                SelectedIndex="{x:Bind ViewModel.StartViewIndex, Mode=TwoWay}" />

      <ToggleSwitch Header="{x:Bind svc:Localizer.T('Settings_ShowSystem')}" IsOn="{x:Bind ViewModel.ShowSystemDevices, Mode=TwoWay}" />

      <StackPanel Spacing="2">
        <ToggleSwitch Header="{x:Bind svc:Localizer.T('Settings_UseSerial')}" IsOn="{x:Bind ViewModel.UseSerialNumberInLinks, Mode=TwoWay}" />
        <TextBlock Text="{x:Bind svc:Localizer.T('Settings_UseSerial_Help')}" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
      </StackPanel>

      <ToggleSwitch Header="{x:Bind svc:Localizer.T('Settings_SerialInExports')}" IsOn="{x:Bind ViewModel.IncludeSerialNumberInExports, Mode=TwoWay}" />

      <StackPanel Spacing="2">
        <ToggleSwitch Header="{x:Bind svc:Localizer.T('Settings_UpdateCatalog')}" IsOn="{x:Bind ViewModel.UpdateCatalogOnline, Mode=TwoWay}" />
        <TextBlock Text="{x:Bind svc:Localizer.T('Settings_UpdateCatalog_Help')}" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Content="{x:Bind svc:Localizer.T('Settings_OpenLogs')}" Command="{x:Bind ViewModel.OpenLogFolderCommand}" />
        <TextBlock Text="{x:Bind ViewModel.DataDirectory}" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
      </StackPanel>

      <StackPanel Spacing="4" Margin="0,8,0,0">
        <TextBlock Text="{x:Bind svc:Localizer.T('Settings_About')}" Style="{StaticResource BodyStrongTextBlockStyle}" />
        <TextBlock Text="{x:Bind ViewModel.AboutText}" TextWrapping="Wrap" />
        <TextBlock Text="{x:Bind svc:Localizer.T('Settings_Privacy')}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</ContentDialog>
