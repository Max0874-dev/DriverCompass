<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DriverCompass.App.Views.SimpleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:DriverCompass.App.Services"
    xmlns:vm="using:DriverCompass.App.ViewModels">

  <UserControl.Resources>
    <CollectionViewSource x:Name="GroupsSource" IsSourceGrouped="True" />
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*" Padding="24,8,24,0">
    <!-- Plain-language summary -->
    <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,12">
      <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
      <TextBlock Text="{x:Bind ViewModel.SummaryDetail, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>

    <ListView Grid.Row="1" ItemsSource="{x:Bind GroupsSource.View, Mode=OneWay}" SelectionMode="None" Padding="0,0,0,24">
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="Margin" Value="0,3" />
        </Style>
      </ListView.ItemContainerStyle>

      <ListView.GroupStyle>
        <GroupStyle>
          <GroupStyle.HeaderTemplate>
            <DataTemplate x:DataType="vm:DeviceGroupViewModel">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="{x:Bind StatusGlyph}" Foreground="{x:Bind StatusBrush}" FontSize="16" />
                <TextBlock Text="{x:Bind Header}" Style="{StaticResource BodyStrongTextBlockStyle}" />
              </StackPanel>
            </DataTemplate>
          </GroupStyle.HeaderTemplate>
        </GroupStyle>
      </ListView.GroupStyle>

      <ListView.ItemTemplate>
        <DataTemplate x:DataType="vm:DeviceItemViewModel">
          <Grid Padding="16,12" ColumnSpacing="14" ColumnDefinitions="Auto,*,Auto" CornerRadius="8" BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">

            <!-- Traffic light: colour + icon, so it also works for colour-blind users -->
            <Grid Width="28" Height="28" VerticalAlignment="Top">
              <Ellipse Fill="{x:Bind StatusBrush}" />
              <FontIcon Glyph="{x:Bind StatusGlyph}" FontSize="14" Foreground="White" />
            </Grid>

            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
              <TextBlock Text="{x:Bind Category}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <TextBlock Text="{x:Bind Reason}" TextWrapping="Wrap" Margin="0,4,0,0" />
              <TextBlock Text="{x:Bind Note}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         Visibility="{x:Bind svc:StatusVisuals.VisibleIfText(Note)}" />
              <!-- Stage 2: version verdict, only after "Check versions" -->
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0" Visibility="{x:Bind svc:StatusVisuals.VisibleIf(HasVersionCheck)}">
                <FontIcon Glyph="{x:Bind VersionGlyph}" Foreground="{x:Bind VersionBrush}" FontSize="12" />
                <TextBlock Text="{x:Bind VersionStatusText}" Foreground="{x:Bind VersionBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind LatestVersionText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Style="{StaticResource AccentButtonStyle}"
                      Content="{x:Bind svc:Localizer.T('Simple_GetDriver')}"
                      Command="{x:Bind GetDriverCommand}"
                      ToolTipService.ToolTip="{x:Bind PrimaryLink.Label}"
                      Visibility="{x:Bind svc:StatusVisuals.VisibleIf(ShowGetDriver)}" />
              <Button Content="{x:Bind SourcesLabel}" Visibility="{x:Bind svc:StatusVisuals.VisibleIf(HasLinks)}">
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedRight">
                    <ItemsControl ItemsSource="{x:Bind Links}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LinkViewModel">
                          <HyperlinkButton Command="{x:Bind OpenCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel>
                              <TextBlock Text="{x:Bind Label}" />
                              <TextBlock Text="{x:Bind Host}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                          </HyperlinkButton>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <TextBlock Text="{x:Bind svc:Localizer.T('Simple_NoLinks')}" VerticalAlignment="Center"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         Visibility="{x:Bind svc:StatusVisuals.VisibleIf(ShowNoLinks)}" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</UserControl>
