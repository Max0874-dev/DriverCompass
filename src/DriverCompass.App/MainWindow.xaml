<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DriverCompass.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:DriverCompass.App.Services"
    xmlns:views="using:DriverCompass.App.Views">

  <Grid x:Name="Root" RowDefinitions="Auto,Auto,Auto,*,Auto">

    <!-- Header + commands -->
    <Grid Grid.Row="0" Padding="24,16,16,8" ColumnDefinitions="*,Auto">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{x:Bind ViewModel.Title}" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock Text="{x:Bind svc:Localizer.T('App_Tagline')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>

      <CommandBar Grid.Column="1" DefaultLabelPosition="Right" Background="Transparent" VerticalAlignment="Center" OverflowButtonVisibility="Collapsed">
        <AppBarButton Icon="Refresh" Label="{x:Bind svc:Localizer.T('Cmd_Scan')}" Command="{x:Bind ViewModel.ScanCommand}" />
        <AppBarButton Label="{x:Bind svc:Localizer.T('Cmd_CheckVersions')}" Command="{x:Bind ViewModel.CheckVersionsCommand}"
                      Visibility="{x:Bind svc:StatusVisuals.VisibleIfNot(ViewModel.IsCheckingVersions), Mode=OneWay}">
          <AppBarButton.Icon>
            <FontIcon Glyph="&#xE895;" />
          </AppBarButton.Icon>
        </AppBarButton>
        <AppBarButton Icon="Cancel" Label="{x:Bind svc:Localizer.T('Cmd_CancelVersionCheck')}" Command="{x:Bind ViewModel.CheckVersionsCancelCommand}"
                      Visibility="{x:Bind svc:StatusVisuals.VisibleIf(ViewModel.IsCheckingVersions), Mode=OneWay}" />
        <AppBarToggleButton Label="{x:Bind svc:Localizer.T('Cmd_ViewExpert')}" IsChecked="{x:Bind ViewModel.IsExpertMode, Mode=TwoWay}">
          <AppBarToggleButton.Icon>
            <FontIcon Glyph="&#xE8FD;" />
          </AppBarToggleButton.Icon>
        </AppBarToggleButton>
        <AppBarButton Label="{x:Bind svc:Localizer.T('Cmd_History')}" Command="{x:Bind ViewModel.ShowHistoryCommand}">
          <AppBarButton.Icon>
            <FontIcon Glyph="&#xE81C;" />
          </AppBarButton.Icon>
        </AppBarButton>
        <AppBarButton Icon="Save" Label="{x:Bind svc:Localizer.T('Cmd_Export')}">
          <AppBarButton.Flyout>
            <MenuFlyout Placement="Bottom">
              <MenuFlyoutItem Text="{x:Bind svc:Localizer.T('Cmd_ExportHtml')}" Command="{x:Bind ViewModel.ExportCommand}" CommandParameter="html" />
              <MenuFlyoutItem Text="{x:Bind svc:Localizer.T('Cmd_ExportCsv')}" Command="{x:Bind ViewModel.ExportCommand}" CommandParameter="csv" />
            </MenuFlyout>
          </AppBarButton.Flyout>
        </AppBarButton>
        <AppBarButton Icon="Setting" Label="{x:Bind svc:Localizer.T('Cmd_Settings')}" Command="{x:Bind ViewModel.OpenSettingsCommand}" />
      </CommandBar>
    </Grid>

    <StackPanel Grid.Row="1">
      <InfoBar Margin="24,0,24,4" IsClosable="False" Severity="Informational"
               IsOpen="{x:Bind ViewModel.IsMockMode}"
               Message="{x:Bind svc:Localizer.T('Mock_Banner')}" />

      <!-- Optional update hint (off by default): only a link to the release page, nothing is downloaded -->
      <InfoBar Margin="24,0,24,4" Severity="Informational"
               Title="{x:Bind svc:Localizer.T('Update_Title')}"
               IsOpen="{x:Bind ViewModel.IsUpdateAvailable, Mode=TwoWay}"
               Message="{x:Bind ViewModel.UpdateMessage, Mode=OneWay}">
        <InfoBar.ActionButton>
          <Button Content="{x:Bind svc:Localizer.T('Update_Open')}" Command="{x:Bind ViewModel.OpenUpdatePageCommand}" />
        </InfoBar.ActionButton>
      </InfoBar>
    </StackPanel>

    <StackPanel Grid.Row="2" Margin="24,0,24,4" Spacing="4" Visibility="{x:Bind svc:StatusVisuals.VisibleIf(ViewModel.IsCheckingVersions), Mode=OneWay}">
      <TextBlock Text="{x:Bind ViewModel.VersionProgressText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
      <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsCheckingVersions, Mode=OneWay}" />
    </StackPanel>

    <StackPanel Grid.Row="2" Margin="24,0,24,4" Spacing="4" Visibility="{x:Bind svc:StatusVisuals.VisibleIf(ViewModel.IsInstalling), Mode=OneWay}">
      <TextBlock Text="{x:Bind ViewModel.InstallProgressText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
      <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsInstalling, Mode=OneWay}" />
    </StackPanel>

    <InfoBar Grid.Row="2" Margin="24,0,24,4"
             IsOpen="{x:Bind ViewModel.IsInfoOpen, Mode=TwoWay}"
             Severity="{x:Bind ViewModel.InfoSeverity, Mode=OneWay}"
             Message="{x:Bind ViewModel.InfoMessage, Mode=OneWay}">
      <InfoBar.ActionButton>
        <Button Content="{x:Bind svc:Localizer.T('Export_Open')}"
                Command="{x:Bind ViewModel.OpenInfoActionCommand}"
                Visibility="{x:Bind svc:StatusVisuals.VisibleIf(ViewModel.HasInfoAction), Mode=OneWay}" />
      </InfoBar.ActionButton>
    </InfoBar>

    <Grid Grid.Row="3">
      <views:SimpleView x:Name="SimpleViewControl" Visibility="{x:Bind svc:StatusVisuals.VisibleIfNot(ViewModel.IsExpertMode), Mode=OneWay}" />
      <views:ExpertView x:Name="ExpertViewControl" Visibility="{x:Bind svc:StatusVisuals.VisibleIf(ViewModel.IsExpertMode), Mode=OneWay}" />
      <ProgressRing Width="56" Height="56" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="4" Padding="24,6" BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="{x:Bind ViewModel.SystemText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.VersionText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Margin="16,0,0,0"
                   MaxWidth="520" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.VersionText, Mode=OneWay}" />
        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.CatalogText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Margin="16,0,0,0" />
      </Grid>
    </Border>
  </Grid>
</Window>
